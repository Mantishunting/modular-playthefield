  m_Name: 
  m_EditorClassIdentifier: 
  tutorialText: {fileID: 2030375246}
  messages:
  - You're a bean!
  - Click the Wood button to grow your stem. Try it now!
  - Click Leaf to add leaves to your body.
  - You're not ready to flower... yet.
  - Reach for the light!
  - Leaves only produce food when they're in sunlight.
  - "Be careful \u2014 light comes and goes, so spread out your leaves."
  - When the bar spins and turns red, you'll start losing branches.
  - Each block has an upkeep cost.
  - Balance your resources as well as your branches.
  - You are beautiful, and you will grow far and wide.
  fadeInDuration: 0.6
  holdDuration: 4
  fadeOutDuration: 0.2
  delayBetweenMessages: 0.2
  playOnStart: 1
  showDebugLogs: 0
